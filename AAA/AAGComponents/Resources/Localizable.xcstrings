    "today.heartRate.aboutBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Herzfrequenz gibt an, wie oft das Herz pro Minute schlägt. Bewegung, Fitness, Schlaf und manche Medikamente können die Messwerte beeinflussen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heart rate measures how many times your heart beats per minute. Activity, fitness, sleep, and some medicines can affect the readings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia cardíaca indica cuántas veces late el corazón por minuto. La actividad, la forma física, el sueño y algunos medicamentos pueden influir en las mediciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fréquence cardiaque indique combien de fois le cœur bat par minute. L’activité, la condition physique, le sommeil et certains médicaments peuvent influencer les mesures."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数は、心臓が1分間に何回拍動するかを示します。活動量、体力、睡眠、薬の影響で測定値は変わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率是心脏每分钟跳动的次数。活动、体能、睡眠和某些药物都可能影响测量值。"
          }
        }
      }
    },
