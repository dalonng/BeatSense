    "today.heartRate.about" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über die Herzfrequenz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About Heart Rate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de la frecuencia cardíaca"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À propos de la fréquence cardiaque"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数について"
          }
