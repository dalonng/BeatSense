            "value" : "La mediana diaria usa la franja de la última medición del día. La referencia usa una misma franja horaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La médiane de chaque jour utilise le créneau de sa dernière mesure. La référence utilise un seul créneau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日ごとの中央値は、その日の最終測定と同じ時間帯から算出します。基準値には共通の時間帯を使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日中位数取当天最后一次读数所在的时段。基线取同一参考时段。"
          }
        }
      }
