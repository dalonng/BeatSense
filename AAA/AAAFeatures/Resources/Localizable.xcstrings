    "healthHistory.retention.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Anzahl der Tage als ganze Zahl größer als null ein. BeatSense entfernt ältere Daten aus dem lokalen Speicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a whole number greater than zero. BeatSense removes older data from its local storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce un número entero mayor que cero. BeatSense elimina los datos más antiguos de su almacenamiento local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un nombre entier supérieur à zéro. BeatSense supprime les données plus anciennes de son stockage local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1以上の整数を入力してください。BeatSenseは保存期間を過ぎたデータを端末内のストレージから削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入大于零的整数。BeatSense 会从本地存储中删除超过保留期限的数据。"
          }
        }
      }
    },
